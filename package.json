{
  "name": "a2a-to-mcp",
  "version": "0.1.0",
  "description": "Expose A2A v1.0.1 agents as MCP tools on a stateless MCP 2026-07-28 server, with the io.modelcontextprotocol/tasks extension",
  "mcpName": "io.github.AmirK-S/a2a-to-mcp",
  "license": "Apache-2.0",
  "author": "Amir Kellou-Sidhoum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirK-S/a2a-to-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "a2a-to-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:helloworld": "vitest run test/integration/helloworld.test.ts",
    "conformance": "node scripts/conformance/run.mjs",
    "conformance:report": "node scripts/conformance/summarize.mjs",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "mcp",
    "a2a",
    "model-context-protocol",
    "agent2agent",
    "bridge",
    "2026-07-28"
  ],
  "protocols": {
    "mcp": "2026-07-28",
    "mcpLegacy": "2025-11-25",
    "mcpTasksExtension": "io.modelcontextprotocol/tasks@2026-07-28",
    "a2a": "1.0.1"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
